
"use client";

import { useState } from "react";
import Link from "next/link";

export default function LoginPage() {
  const [username, setUsername] = useState("");
  const [password, setPassword] = useState("");
  const [showPassword, setShowPassword] = useState(false);
  const [message, setMessage] = useState("");

  function handleSubmit(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();

    if (!username.trim() || !password) {
      setMessage("Please enter your username and password.");
      return;
    }

    // Username/password verification will be connected next.
    setMessage("Login verification will be connected in the next step.");
  }

  return (
    <main className="relative flex min-h-screen items-center justify-center overflow-hidden bg-[#130C0A] px-5 py-12 text-[#FFF5E9]">
      {/* Background */}
      <div className="absolute inset-0 bg-[radial-gradient(circle_at_top_left,#593022_0%,transparent_45%),radial-gradient(circle_at_bottom_right,#46301D_0%,transparent_40%)]" />

      <div className="pointer-events-none absolute left-10 top-16 text-5xl text-[#D7AC72]/25">
        ✦
      </div>
      <div className="pointer-events-none absolute bottom-16 right-10 text-6xl text-[#D7AC72]/25">
        ✧
      </div>

      <div className="relative z-10 w-full max-w-md">
        <Link
          href="/"
          className="mb-8 inline-flex items-center gap-2 text-sm text-[#D7B78B] transition hover:text-white"
        >
          ← Back to Zestique
        </Link>

        <div className="rounded-[32px] border border-[#D8B786]/25 bg-[#241813]/95 p-7 shadow-2xl shadow-black/40 sm:p-10">
          <div className="mb-8 text-center">
            <div className="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-full border border-[#D7AC72]/40 bg-[#D7AC72]/10 text-3xl text-[#E5BD83]">
              ✦
            </div>

            <p className="mb-3 text-xs font-semibold uppercase tracking-[0.3em] text-[#D7AC72]">
              Exclusive Access
            </p>

            <h1 className="font-serif text-4xl font-bold tracking-wide text-[#FFF4E5]">
              Welcome Back
            </h1>

            <p className="mt-3 text-sm leading-6 text-[#BFAEA0]">
              Sign in to your Zestique account
            </p>
          </div>

          <form onSubmit={handleSubmit} className="space-y-6">
            {/* Username */}
            <div>
              <label
                htmlFor="username"
                className="mb-2 block text-sm font-medium text-[#E9D4B8]"
              >
                Username
              </label>

              <input
                id="username"
                type="text"
                value={username}
                onChange={(event) =>
                  setUsername(
                    (event.target as unknown as { value: string }).value
                  )
                }
                placeholder="Enter your username"
                autoComplete="username"
                required
                className="w-full rounded-xl border border-[#8D7158]/50 bg-[#150F0C] px-4 py-4 text-[#FFF5E9] outline-none transition placeholder:text-[#806C5F] focus:border-[#D7AC72]"
              />
            </div>

            {/* Password */}
            <div>
              <label
                htmlFor="password"
                className="mb-2 block text-sm font-medium text-[#E9D4B8]"
              >
                Password
              </label>

              <div className="relative">
                <input
                  id="password"
                  type={showPassword ? "text" : "password"}
                  value={password}
                  onChange={(event) =>
                    setPassword(
                      (event.target as unknown as { value: string }).value
                    )
                  }
                  placeholder="Enter your password"
                  autoComplete="current-password"
                  required
                  className="w-full rounded-xl border border-[#8D7158]/50 bg-[#150F0C] px-4 py-4 pr-14 text-[#FFF5E9] outline-none transition placeholder:text-[#806C5F] focus:border-[#D7AC72]"
                />

                {/* Eye icon */}
                <button
                  type="button"
                  onClick={() => setShowPassword(!showPassword)}
                  aria-label={
                    showPassword ? "Hide password" : "Show password"
                  }
                  title={
                    showPassword ? "Hide password" : "Show password"
                  }
                  className="absolute inset-y-0 right-4 flex items-center text-[#D7AC72] transition hover:text-white"
                >
                  {showPassword ? (
                    <svg
                      width="23"
                      height="23"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      strokeWidth="1.8"
                      strokeLinecap="round"
                      strokeLinejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M3 3l18 18" />
                      <path d="M10.6 5.1A10.8 10.8 0 0112 5c5.3 0 9 7 9 7a16.4 16.4 0 01-3.1 3.7" />
                      <path d="M6.5 6.5C4.1 8.1 3 12 3 12s3.7 7 9 7a9.6 9.6 0 004.1-.9" />
                      <path d="M10 10a2.8 2.8 0 004 4" />
                    </svg>
                  ) : (
                    <svg
                      width="23"
                      height="23"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      strokeWidth="1.8"
                      strokeLinecap="round"
                      strokeLinejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M2 12s3.7-7 10-7 10 7 10 7-3.7 7-10 7S2 12 2 12Z" />
                      <circle cx="12" cy="12" r="3" />
                    </svg>
                  )}
                </button>
              </div>

              <p className="mt-2 text-xs text-[#A99583]">
                Tap the eye icon to show or hide your password.
              </p>
            </div>

            <button
              type="submit"
              className="w-full rounded-xl bg-gradient-to-r from-[#C99A5B] to-[#E9C38C] px-5 py-4 font-bold tracking-wider text-[#21150E] shadow-lg shadow-[#C99A5B]/10 transition hover:brightness-110"
            >
              LOGIN →
            </button>

            {message && (
              <p
                role="status"
                className="rounded-xl border border-[#D7AC72]/30 bg-[#D7AC72]/10 p-3 text-center text-sm text-[#E9D4B8]"
              >
                {message}
              </p>
            )}
          </form>

          <div className="mt-8 border-t border-[#D7AC72]/20 pt-6 text-center">
            <p className="font-serif text-lg italic text-[#D7AC72]">
              Where Every Flavor Tells a Story
            </p>
          </div>
        </div>

        <p className="mt-6 text-center text-xs tracking-widest text-[#9D8571]">
          ZESTIQUE • THE ART OF FINE DINING
        </p>
      </div>
    </main>
  );
}
